{
  "name": "kaede-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:wasm": "wasm-pack build ../../crates/kaede-client-wasm --target web --out-dir ../../apps/web/src/wasm/pkg",
    "test:e2e": "node e2e/run.cjs",
    "test:e2e:fast": "node e2e/run.cjs --skip-media",
    "test:e2e:pq": "node e2e/run.cjs --only=pq",
    "test:e2e:mls": "node e2e/run.cjs --only=mls",
    "test:e2e:network": "node e2e/run.cjs --only=network",
    "test:pw": "playwright test",
    "test:pw:smoke": "playwright test e2e-standard/01-smoke.spec.ts",
    "test:pw:enc": "playwright test e2e-standard/02-encryption.spec.ts",
    "test:pw:ui": "playwright test --ui"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@lexical/code": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "@tanstack/react-query": "^5.62.0",
    "lexical": "^0.53.0",
    "livekit-client": "^2.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}

