# KaedeNiwa 部署环境变量样例
# 复制为 deploy/.env 后填写；不要提交真实密钥。

# ---- 监听与数据库 ----
# 本机部署保持 127.0.0.1，公网流量交给 Caddy/Nginx。
KAEDE_BIND=127.0.0.1:18080
KAEDE_DB=sqlite:///var/lib/kaede/kaede.db?mode=rwc
KAEDE_SESSION_TTL_HOURS=168
# 附件等运行时数据的根目录（默认 <cwd>/data）。
KAEDE_DATA_DIR=/var/lib/kaede/data
# 可信反向代理（逗号分隔 IP/CIDR）。默认只信任 loopback。
# docker compose 场景由 compose 自动设置为 Docker bridge 网段；
# 裸机 Nginx/Caddy 在同机时无需设置。
# KAEDE_TRUSTED_PROXIES=172.28.0.0/16

# 允许的浏览器来源，逗号分隔。生产禁止使用 *。
KAEDE_CORS_ORIGINS=https://kaede.example.com

# human（默认）或 json（Loki/ELK/CloudWatch）
KAEDE_LOG_FORMAT=json
RUST_LOG=info,kaede_server=info

# ---- LiveKit（必填，缺失时服务端拒绝启动）----
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_WS_URL=wss://livekit.example.com
# 媒体吊销（踢人/封禁/移除频道成员）走 RoomService HTTP API。
# 默认由 LIVEKIT_WS_URL 推导（ws→http / wss→https）；WS 与 HTTP 不同端口时设置。
# KAEDE_LIVEKIT_HTTP_URL=https://livekit.example.com

# 仅本地开发可跳过 LiveKit 校验（/api/livekit/* 会 500）。
# KAEDE_SKIP_LIVEKIT_ENV_CHECK=1

# ---- 管理后台（可选）----
# 保持 loopback + SSH 隧道，或在反向代理后加 HTTPS + IP 白名单。
KAEDE_ADMIN_ENABLED=0
KAEDE_ADMIN_BIND=127.0.0.1:18081
# openssl rand -hex 32
KAEDE_ADMIN_TOKEN=

# ---- docker compose 用 ----
KAEDE_DOMAIN=kaede.example.com
