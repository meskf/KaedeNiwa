# 如果配置了 KAEDE_DOMAIN，Caddy 会自动申请 SSL 证书并开启 443
{$KAEDE_DOMAIN:localhost} {
    root * /srv/kaede
    try_files {path} /index.html

    handle /api/* {
        reverse_proxy kaede:18080
    }

    handle /ws* {
        reverse_proxy kaede:18080
    }

    # LiveKit WebSocket 信令代理
    handle /livekit/* {
        uri strip_prefix /livekit
        reverse_proxy livekit:7880
    }

    file_server
}
