# KaedeNiwa 一体化部署配置（docker compose 自动读取 .env）
# 复制为 .env 后按需修改：cp .env.example .env

# 对外 HTTP 端口（Caddy 监听容器内 8080）
KAEDE_HTTP_PORT=8080

# 浏览器/客户端访问的 CORS 白名单（逗号分隔）。默认 * 适合私有部署 + Token 认证；
# 若使用自定义域名并希望收紧，可改成具体 origin。
KAEDE_CORS_ORIGINS=*

# LiveKit 密钥（key 名保持 devkey 与 livekit 的 webhook.api_key 一致）。
# secret 至少 32 位，修改后 compose 会同时注入 server 与 livekit。
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=12345678901234567890123456789012

# 媒体端口（浏览器/客户端网络需可达）
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# 语音媒体的对外 IP 策略：
# - 公网部署（已把 7881/7882 转发到本机）：保持默认，LiveKit 用 STUN 自动探测公网 IP。
# - 纯局域网部署（如 192.168.1.x）：必须填服务器 LAN IP 并关闭 STUN，否则客户端拿到的
#   是公网 IP、连不上媒体端口，表现为“已进入语音频道但一直连不上媒体”。
# LIVEKIT_NODE_IP=192.168.1.3
# LIVEKIT_USE_EXTERNAL_IP=false

# LiveKit 镜像版本
LIVEKIT_VERSION=v1.13.9
